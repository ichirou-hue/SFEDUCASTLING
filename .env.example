# Скопируйте этот файл в .env (в корне проекта) и отредактируйте при необходимости.
#
#   cp .env.example .env        # Linux / macOS
#   copy .env.example .env      # Windows
#
# .env в git не попадает, поэтому каждый разработчик заводит свой.

# --- База данных -------------------------------------------------------------
# По умолчанию используется SQLite в корне проекта (backend.db):
# работает без установки и на Windows, и на Linux.
# Запускать приложение нужно из корня проекта (см. run.sh / run.bat).
DATABASE_URL=sqlite+aiosqlite:///./backend.db

# Для PostgreSQL раскомментируйте строку ниже и закомментируйте SQLite:
# (список зависимостей уже содержит и asyncpg, и aiosqlite)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/sfeducastling

DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- Аутентификация ----------------------------------------------------------
# В проде ОБЯЗАТЕЛЬНО замените на длинный случайный секрет.
JWT_SECRET_KEY=dev-key-change-me
ACCESS_TOKEN_TTL_MIN=1440
REFRESH_TOKEN_TTL_DAYS=30

# --- Сервер ------------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8005

# --- Прочее ------------------------------------------------------------------
# DEBUG=true
# ALLOWED_ORIGINS=["*"]
# STOCKFISH_PATH=stockfish_engine/stockfish.exe
